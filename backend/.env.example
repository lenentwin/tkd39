NODE_ENV=development
PORT=3001
BACKEND_URL=http://127.0.0.1:3001
FRONTEND_URL=http://127.0.0.1:5173/
FRONTEND_PORT=5173
# Leave BOTH empty until a VK application and an exact redirect are registered.
VK_CLIENT_ID=
VK_REDIRECT_URI=
# Optional for local development only: an ephemeral key is generated in memory.
# Supply at least 32 random bytes (base64url) through the private environment.
SESSION_SECRET=
SESSION_STORE=memory
OAUTH_TTL_SECONDS=300
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
# No Client Secret is used by the chosen VK Web SDK PKCE public-client flow.
# No mock-provider switch exists in the runnable server.
